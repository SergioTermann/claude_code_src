# 生产默认：单进程 + waitress 多线程，支持多用户同时访问
APP_HOST=0.0.0.0
APP_PORT=5002
WEB_SERVER=auto
WEB_THREADS=32
TARGET_CONCURRENCY=30
HTTP_POOL_SIZE=64
SERVER_REQUEST_QUEUE_SIZE=128
SQLITE_BUSY_TIMEOUT_MS=30000
MAX_CACHED_CONVERSATIONS=200

# 用户库放在 data/，升级代码目录时不丢失；启动时从 deploy/seed/chat_users.db 自动灌入
CHAT_DB_FILE=../data/chat_users.db
