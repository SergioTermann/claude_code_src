# Web 监听地址：0.0.0.0 表示所有网卡；模型服务地址见 VLLM_API_URL
APP_HOST=0.0.0.0
APP_PORT=5002

# Flask session 密钥。生产部署请改成随机长字符串。
SECRET_KEY=change-this-to-a-random-secret
SESSION_COOKIE_SAMESITE=Lax
# 启用 HTTPS 后请设为 1
SESSION_COOKIE_SECURE=0

# 初始管理员账号（离线部署默认 admin / admin）
INIT_ADMIN_USERNAME=admin
INIT_ADMIN_PASSWORD=admin

# 登录与聊天限流（可按需调整）
# LOGIN_RATE_LIMIT_MAX=5
# LOGIN_LOCKOUT_THRESHOLD=10
# CHAT_RATE_LIMIT_MAX=30

# 跨域访问。默认关闭；仅在有可信前端域名时配置，逗号分隔
# CORS_ALLOWED_ORIGINS=https://your-frontend.example.com

# Dify 应用。默认要求必须配置 Dify；否则网页会明确报错，避免误走本地模型。
# DIFY_API_URL 可以填 http://DIFY地址/v1，程序会按 DIFY_APP_TYPE 自动补 endpoint。
# DIFY_APP_TYPE=chat 时调用 /v1/chat-messages，支持 Dify conversation_id 续聊。
# DIFY_APP_TYPE=workflow 时调用 /v1/workflows/run，默认传 inputs.query 和 inputs.question。
DIFY_REQUIRED=1
DIFY_API_URL=
DIFY_API_KEY=
DIFY_APP_TYPE=chat

# Windrise 本地问答。设为 1 后，网页 /api/chat 会调用 bin/windrise，
# 前端和会话保存逻辑不需要修改。WINDRISE_BIN 可按部署路径覆盖。
WINDRISE_ENABLED=0
WINDRISE_BIN=../bin/windrise
WINDRISE_TIMEOUT=300
WINDRISE_CWD=..
WINDRISE_MEMORY_LOAD_MESSAGES=24
WINDRISE_MEMORY_CONTEXT_MESSAGES=16
WINDRISE_MEMORY_ITEM_CHARS=800
WINDRISE_SEMANTIC_ROUTER_ENABLED=1
WINDRISE_SEMANTIC_ROUTER_TIMEOUT=20
WINDRISE_SINGLE_SEMANTIC_PASS=1
WINDRISE_QUERY_CONSOLIDATOR_ENABLED=1
WINDRISE_QUERY_CONSOLIDATOR_TIMEOUT=45
WINDRISE_CHAT_TIMEOUT=45
WINDRISE_LLMWIKI_TIMEOUT=4
WINDRISE_LLM_RETRY_SECONDS=5
WINDRISE_LLM_FIRST_ENABLED=1
WINDRISE_STREAM_CHUNK_DELAY=0.02
# LLMWIKI_PROJECT=/path/to/project
# LLMWIKI_DIR=/path/to/generated-knowledge

# 本地 OpenAI-compatible/vLLM 后备模型接口。
LLM_PROVIDER_NAME=Local vLLM
VLLM_API_URL=http://127.0.0.1:9527/v1/chat/completions
VLLM_MODEL_NAME=Qwen-30B
VLLM_API_KEY=

# 知识库目录和索引配置。
RAG_KB_DIR=wind_power_wiki
RAG_INDEX_DIR=langchain_index

# 离线基础部署建议用 hash：不需要 torch、transformers、sentence-transformers 或模型文件。
# 如需更高质量检索，再改成 qwen3_local 并准备 offline_models 与增强依赖。
RAG_EMBEDDING_BACKEND=hash
RAG_FALLBACK_EMBEDDING_DIM=384
RAG_RERANKER_ENABLED=0

# 增强模式示例：
# RAG_EMBEDDING_BACKEND=qwen3_local
# RAG_EMBEDDING_MODEL=offline_models/Qwen3-Embedding-0.6B
# RAG_RERANKER_ENABLED=1
# RAG_RERANKER_MODEL=offline_models/Qwen3-Reranker-0.6B

# CORS 默认不携带凭证跨域。局域网同源访问通常不用配置。
CORS_ALLOWED_ORIGINS=

# Web 报错时是否在服务端日志打印完整 traceback（离线排查建议保持 1）
WEB_ERROR_VERBOSE=1
# LOG_EXCEPTION_TRACEBACK=1

# Web 并发：单进程 + 多线程（processes 固定为 1，与内存会话/Windrise 状态共享一致）
# WEB_THREADS=32
# TARGET_CONCURRENCY=30
# WEB_SERVER=auto   # auto | waitress | werkzeug
