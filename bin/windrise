#!/usr/bin/env zsh
set -euo pipefail

ROOT="${0:A:h:h}"
RUNNER="$ROOT/scripts/run-lmstudio-claude.mjs"
CHAT="$ROOT/scripts/windrise-chat.mjs"

if [[ -n "${LLMWIKI_PROJECT:-}" ]]; then
  export LLMWIKI_PROJECT
fi
if [[ -n "${LLMWIKI_DIR:-}" ]]; then
  export LLMWIKI_DIR
fi
export ANTHROPIC_MODEL_PROVIDER="${ANTHROPIC_MODEL_PROVIDER:-lmstudio}"
export LMSTUDIO_CHAT_MODEL="${LMSTUDIO_CHAT_MODEL:-Qwen-30B}"
export LMSTUDIO_MODEL="${LMSTUDIO_MODEL:-Qwen-30B}"
export LMSTUDIO_FORCE_CHAT="${LMSTUDIO_FORCE_CHAT:-1}"
export MAX_THINKING_TOKENS="${MAX_THINKING_TOKENS:-0}"
export WINDRISE_ENABLE_THINKING="${WINDRISE_ENABLE_THINKING:-0}"
export LMSTUDIO_BASE_URL="${LMSTUDIO_BASE_URL:-http://10.46.161.210:9527}"
export DISABLE_INSTALLATION_CHECKS="${DISABLE_INSTALLATION_CHECKS:-1}"
export WINDRISE=1

show_help() {
  cat <<'EOF'
windrise 用法:
  windrise                         启动 Windrise 完整交互界面
  windrise ask                     启动普通回车对话模式，按需检索
  windrise 303804                  单次对话/检索
  windrise "303804是什么故障"       自动检索知识库并总结
  windrise "llmwiki 303804"        明确检索知识库并总结
  windrise "变桨24V开关怎么处理"   自动检索知识库并总结
  windrise "检索 303804"           检索知识库并总结
  windrise search 偏航 电机        直接检索多个关键词
  windrise web 最新 风机固件       联网搜索并总结
  windrise fetch https://example.com 抓取网页并总结
  windrise weather 北京            查询天气预报
  windrise read <路径>             读取 LLMWiki 文件
  windrise tree [路径]             查看 LLMWiki 目录树
  windrise skills                  查看本地离线 skills
  windrise doctor                  检查本地 vLLM / LLMWiki 状态
  windrise chat                    启动完整交互模式
  windrise help                    显示帮助

关闭自动 LLMWiki 检索:
  WINDRISE_DISABLE_AUTO_LLMWIKI=1 windrise ask
  WINDRISE_DISABLE_AUTO_LLMWIKI=1 windrise "普通问题"
EOF
}

run_llmwiki() {
  node "$RUNNER" --print --bare "$1"
}

search_query() {
  local query="$*"
  local code

  code="$(extract_fault_code "$query")"

  if [[ -n "$code" ]] && is_fault_code_coverage_query "$query" "$code"; then
    run_llmwiki "/llmwiki ask $code --limit 20"
    return
  fi

  if is_fault_code_lookup_query "$query"; then
    run_llmwiki "/llmwiki ask $query --limit 20"
    return
  fi

  if is_fault_name_to_code_query "$query"; then
    run_llmwiki "/llmwiki ask $query --limit 20"
    return
  fi

  if [[ -n "$code" ]]; then
    if is_bare_fault_code_query "$query" "$code"; then
      run_llmwiki "/llmwiki ask $code --limit 8"
    else
      run_llmwiki "/llmwiki ask $query --limit 8"
    fi
    return
  fi

  if is_likely_fault_name_query "$query"; then
    run_llmwiki "/llmwiki ask $query --limit 8"
    return
  fi

  run_llmwiki "/llmwiki search $query --limit 8"
}

is_bare_fault_code_query() {
  local query="$1"
  local code="$2"
  local rest
  rest="$(printf '%s' "$query" \
    | sed "s/$code//" \
    | sed -E 's/(故障码|故障代码|报码|报出|报警码|告警码|代码|fault[[:space:]]*code|是什么|啥|含义|原因|处理|复位|报警|告警|故障|逻辑|怎么|如何|的|为|是|报)//Ig' \
    | sed -E 's/[？?，,。.、:：[:space:]]//g')"
  [[ -z "$rest" ]]
}

extract_fault_code() {
  local query="$*"
  local contextual
  if printf '%s' "$query" | grep -Eiq '(是什么故障码|故障码是什么|故障代码是什么|是什么码|什么码|对应.*码|哪些故障码|有什么故障码|报码|告警码|报警码)' \
    && printf '%s' "$query" | grep -Eiq '(故障|报警|告警|停机|异常|错误|问题|超限|过高|过低|高于|低于|温度|压力|电流|电压|频率|转速|功率|断开|跳开|跳闸|空开|短路|断路|丢失|通信|通讯|传感器|接近开关|超级电容|桨叶|轴[0-9]|[0-9]轴|变桨|偏航|刹车|制动|主控|机舱|塔基|叶片|轮毂|变流器|变频器|发电机|齿轮箱|液压|主断路器|断路器|主断|接触器)'; then
    printf ''
    return
  fi
  if printf '%s' "$query" | perl -ne 'exit(/^\s*\d{1,8}[\p{Han}A-Za-z].*(?:是什么故障码|故障码是什么|故障代码是什么|是什么码|什么码|对应.*码|哪些故障码|有什么故障码|报码|告警码|报警码)/i ? 0 : 1)'; then
    printf ''
    return
  fi
  contextual="$(printf '%s' "$query" | perl -ne 'if (/(?:故障码|故障代码|报码|报出|报|告警码|报警码|报警|告警|状态代码|fault\s*code|alarm\s*code)[^A-Za-z0-9]{0,8}([A-Za-z]{0,4}\d{1,8}[A-Za-z]{0,2})/i) { print $1; exit }' || true)"
  if [[ -n "$contextual" ]]; then
    printf '%s' "$contextual"
    return
  fi
  if printf '%s' "$query" | grep -Eiq '(是什么故障|什么故障|故障|报警|告警|停机|处理|复位|原因|报码|故障码|代码|怎么|如何)' \
    && printf '%s' "$query" | grep -Eiq '(风场|风电场|场站|机型|型号|品牌|厂家|系列|华仪|华锐|金风|歌美飒|运达|明阳|新誉|湘电|远景|三一|团结|洮北|镇赉|镇赍|同发|王玲山|良井子|新华|四平|通榆)'; then
    contextual="$(printf '%s' "$query" | perl -ne 'if (/(?:^|[^A-Za-z0-9])(\d{1,8})(?=[^A-Za-z0-9]|$)/) { print $1; exit }' || true)"
    if [[ -n "$contextual" ]]; then
      printf '%s' "$contextual"
      return
    fi
  fi
  contextual="$(printf '%s' "$query" | perl -ne 'if (/^\s*(?:故障码|故障代码|报码|告警码|报警码|状态代码)?\s*(\d{1,8})(?=\s|[^A-Za-z0-9]|$).*(?:是什么故障|什么故障|故障|报警|告警|停机|处理|复位|原因|为什么|为何|为啥|怎么|如何|会报|报出|含义)/i) { print $1; exit }' || true)"
  if [[ -n "$contextual" ]]; then
    printf '%s' "$contextual"
    return
  fi
  contextual="$(printf '%s' "$query" | perl -ne 'if (/(?:^|[^A-Za-z0-9])([A-Za-z]+\d[\w_.\/-]*\d)(?=\s|[^A-Za-z0-9]|$)/) { print $1; exit }' || true)"
  if [[ -n "$contextual" ]]; then
    printf '%s' "$contextual"
    return
  fi
  printf '%s' "$query" | grep -Eo '[0-9]{3,}' | head -n 1 || true
}

is_fault_code_lookup_query() {
  local query="$*"
  is_fault_name_to_code_query "$query" && return 1
  printf '%s' "$query" | grep -Eiq '(故障码|故障代码|报码|告警码|报警码|状态代码).*(是什么|多少|哪些|有啥|对应|查询|查|找)|(是什么|多少|哪些|有啥|对应|查询|查|找).*(故障码|故障代码|报码|告警码|报警码|状态代码)'
}

is_fault_code_coverage_query() {
  local query="$1"
  local code="${2:-}"
  printf '%s' "$query" | grep -Eiq '(哪些风场|有哪些风场|哪些场站|有哪些场站|哪些机型|有哪些机型|哪些型号|有哪些型号|覆盖|分布|也有|都有)' || return 1
  printf '%s' "$query" | grep -Eiq '(这个码|该码|这个故障码|该故障码|这个代码|该代码)' && return 0
  if [[ -n "$code" ]] && printf '%s' "$query" | perl -ne 'BEGIN { $code = shift @ARGV } exit(/(?:故障码|故障代码|报码|告警码|报警码|状态代码)[^A-Za-z0-9]{0,8}\Q$code\E/i ? 0 : 1)' "$code"; then
    return 0
  fi
  [[ -n "$code" ]] && is_bare_fault_code_query "$query" "$code"
}

is_fault_name_to_code_query() {
  local query="$*"
  printf '%s' "$query" | grep -Eiq '(是什么故障码|故障码是什么|故障代码是什么|是什么码|什么码|对应.*码|哪些故障码|有什么故障码)' \
    && printf '%s' "$query" | grep -Eiq '(故障|报警|告警|停机|异常|错误|问题|超限|过高|过低|高于|低于|温度|压力|电流|电压|频率|转速|功率|断开|跳开|跳闸|空开|短路|断路|丢失|通信|通讯|传感器|接近开关|超级电容|桨叶|轴[0-9]|[0-9]轴|变桨|偏航|刹车|制动|主控|机舱|塔基|叶片|轮毂|变流器|变频器|发电机|齿轮箱|液压|主断路器|断路器|主断|接触器)'
}

is_likely_fault_name_query() {
  local prompt="$*"
  printf '%s' "$prompt" | grep -Eiq '(风机|风电|变桨|偏航|扭缆|纽缆|扭揽|风速仪|风向仪|主控|机舱|塔基|叶片|轮毂|变流器|变频器|发电机|齿轮箱|液压|制动|刹车|24v|plc|hw2s|华仪|主断路器|断路器|主断|接触器)' \
    && printf '%s' "$prompt" | grep -Eiq '(故障|报警|告警|停机|复位|不可复位|异常|超出|超限|限制|最大|最小|过高|过低|偏高|偏低|高于|低于|温度|过热|发热|高温|超温|过温|压力|电流|电压|频率|转速|功率|跳开|跳闸|跳了|跳掉|跳脱|脱扣|分闸|分断|空开|断开)'
}

run_chat() {
  export CLAUDE_CODE_FORCE_FULL_LOGO="${CLAUDE_CODE_FORCE_FULL_LOGO:-1}"
  exec node "$RUNNER" "$@"
}

run_windrise_chat() {
  exec node "$CHAT" "$@"
}

answer_once() {
  local prompt="$*"
  if is_web_query "$prompt"; then
    printf '%s\nexit\n' "$prompt" | node "$CHAT"
    return
  fi
  if is_knowledge_query "$prompt" \
    && printf '%s' "$prompt" | grep -Eq '^[[:space:]]*(帮我|给我|请)?[[:space:]]*(检索|查询|搜索|查找|查|search)([[:space:]]|一下|下|[:：]|$)'; then
    printf '%s\nexit\n' "$prompt" | node "$CHAT"
    return
  fi
  if is_knowledge_query "$prompt"; then
    printf '%s\nexit\n' "$prompt" | node "$CHAT"
    return
  fi
  printf '%s\nexit\n' "$prompt" | node "$CHAT"
}

is_web_query() {
  local prompt="$*"
  if printf '%s' "$prompt" | grep -Eiq '(天气|气温|降雨|下雨|空气质量|aqi|预报|新闻|最新|current|latest|today|tomorrow|https?://)'; then
    return 0
  fi
  if printf '%s' "$prompt" | grep -Eiq '^[[:space:]]*(帮我|给我|请)?[[:space:]]*(搜索|搜一下|搜索一下|查一下|查询|查找|查)([[:space:]]|一下|下|[:：]|$)' \
    && ! is_knowledge_query "$prompt"; then
    return 0
  fi
  return 1
}

is_knowledge_query() {
  local prompt="$*"
  if [[ "${WINDRISE_DISABLE_AUTO_LLMWIKI:-}" == "1" ]] && ! is_explicit_llmwiki_query "$prompt"; then
    return 1
  fi
  if is_principle_query "$prompt" && ! has_fault_knowledge_signal "$prompt"; then
    return 1
  fi
  if [[ -n "$(extract_fault_code "$prompt")" ]] \
    && printf '%s' "$prompt" | grep -Eiq '(故障码|故障代码|报码|报出|报警码|告警码|报警|告警|状态代码|fault[[:space:]]*code|alarm[[:space:]]*code|^[[:space:]]*报[[:space:]]*[0-9]{1,8})'; then
    return 0
  fi
  if printf '%s' "$prompt" | grep -Eiq '^[[:space:]]*(故障码|代码|fault[[:space:]]*code)?[[:space:]]*[0-9]{3,}([是什么啥含义原因处理复位报警故障逻辑怎么如何？?，,。.、[:space:]]*)?$'; then
    return 0
  fi
  if printf '%s' "$prompt" | grep -Eq '[0-9]{3,}' \
    && printf '%s' "$prompt" | grep -Eiq '(故障|报警|告警|停机|复位|原因|处理|排查|检查|维修|逻辑|怎么|如何|为什么|是什么|含义)'; then
    return 0
  fi
  if printf '%s' "$prompt" | grep -Eiq '(故障码|故障代码|报警码|告警码|fault[[:space:]]*code)'; then
    return 0
  fi
  if printf '%s' "$prompt" | grep -Eiq '(风机|风电|变桨|偏航|扭缆|纽缆|扭揽|风速仪|风向仪|主控|机舱|塔基|叶片|轮毂|变流器|变频器|发电机|齿轮箱|液压|制动|刹车|24v|plc|hw2s|华仪|主断路器|断路器|主断|接触器)' \
    && printf '%s' "$prompt" | grep -Eiq '(故障|报警|告警|停机|复位|不可复位|异常|超出|超限|限制|最大|最小|过高|过低|偏高|偏低|高于|低于|温度|过热|发热|高温|超温|过温|压力|电流|电压|频率|转速|功率|原因|处理|排查|检查|维修|设置值|逻辑|反馈|断开|跳开|跳闸|跳了|跳掉|跳脱|脱扣|分闸|分断|空开|短路|断路|丢失|原理|机理|机制|工作方式|工作过程|运行方式|运行过程|控制逻辑|结构|组成|作用|用途|区别|关系|解释|介绍|怎么|如何|为什么|是什么|啥意思|含义)'; then
    return 0
  fi
  return 1
}

is_explicit_llmwiki_query() {
  local prompt="$*"
  printf '%s' "$prompt" | grep -Eiq '^[[:space:]]*/?(llmwiki|wiki)([[:space:]]|$)'
}

is_principle_query() {
  local prompt="$*"
  printf '%s' "$prompt" | grep -Eiq '(原理|机理|机制|工作方式|工作过程|运行方式|运行过程|怎么工作|如何工作|为什么能|为什么会|怎样实现|怎么实现|如何实现|结构|组成|作用|用途|区别|关系|解释一下|讲一下|介绍一下|科普|控制逻辑|运行逻辑)'
}

has_fault_knowledge_signal() {
  local prompt="$*"
  printf '%s' "$prompt" | grep -Eiq '([A-Za-z]?_?[0-9]{3,}|故障码|故障代码|报警码|告警码|fault[[:space:]]*code|怎么处理|如何处理|处理方法|处置|排查|检查|维修|复位|短路|断路|断路器|跳开|跳闸|跳了|跳掉|跳脱|脱扣|分闸|分断|空开|丢失|不可复位|停机|报警|告警|报错|扭缆|纽缆|扭揽|超限|过热|发热|高温|超温|过温)'
}

if [[ $# -eq 0 ]]; then
  run_chat
fi

case "$1" in
  help|-h|--help)
    show_help
    ;;
  chat)
    run_chat
    ;;
  ask)
    run_windrise_chat
    ;;
  skills)
    run_llmwiki "/lmstudio skills"
    ;;
  doctor)
    run_llmwiki "/lmstudio"
    ;;
  search)
    shift
    if [[ $# -eq 0 ]]; then
      echo "用法: windrise search <关键词>" >&2
      exit 2
    fi
    search_query "$@"
    ;;
  web)
    shift
    if [[ $# -eq 0 ]]; then
      echo "用法: windrise web <关键词>" >&2
      exit 2
    fi
    printf '%s\nexit\n' "web $*" | node "$CHAT"
    ;;
  fetch)
    shift
    if [[ $# -eq 0 ]]; then
      echo "用法: windrise fetch <URL>" >&2
      exit 2
    fi
    printf '%s\nexit\n' "fetch $*" | node "$CHAT"
    ;;
  weather)
    shift
    if [[ $# -eq 0 ]]; then
      echo "用法: windrise weather <城市>" >&2
      exit 2
    fi
    printf '%s\nexit\n' "weather $* 天气" | node "$CHAT"
    ;;
  read)
    shift
    if [[ $# -eq 0 ]]; then
      echo "用法: windrise read <LLMWiki路径>" >&2
      exit 2
    fi
    run_llmwiki "/llmwiki read $*"
    ;;
  tree)
    shift
    if [[ $# -eq 0 ]]; then
      run_llmwiki "/llmwiki tree --depth 2 --limit 50"
      exit 0
    fi
    run_llmwiki "/llmwiki tree $* --depth 2 --limit 50"
    ;;
  *)
    answer_once "$@"
    ;;
esac
