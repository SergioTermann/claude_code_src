<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="10dp"
    android:paddingTop="4dp"
    android:paddingEnd="10dp"
    android:paddingBottom="4dp">

    <!-- 用户消息容器 -->
    <LinearLayout
        android:id="@+id/userMessageContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="horizontal"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="72dp"
            android:background="@drawable/user_message_background"
            android:orientation="vertical">

            <TextView
                android:id="@+id/userMessageText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="2dp"
                android:maxWidth="282dp"
                android:paddingStart="14dp"
                android:paddingTop="11dp"
                android:paddingEnd="14dp"
                android:paddingBottom="11dp"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                tools:text="这是用户的消息" />

            <TextView
                android:id="@+id/userAttachmentText"
                android:layout_width="250dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/pdf_attachment_user_background"
                android:padding="12dp"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:visibility="gone"
                tools:text="PDF 附件：工单.pdf"
                tools:visibility="visible" />
        </LinearLayout>
    </LinearLayout>

    <!-- AI 消息容器 -->
    <LinearLayout
        android:id="@+id/aiMessageContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="start"
        android:orientation="horizontal"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginEnd="8dp"
            android:layout_marginTop="2dp"
            android:src="@drawable/windrise_logo"
            android:padding="3dp"
            android:background="@drawable/profile_avatar_background"
            android:contentDescription="AI头像" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="72dp"
            android:background="@drawable/ai_message_background"
            android:orientation="vertical">

            <TextView
                android:id="@+id/aiMessageText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="2dp"
                android:maxWidth="282dp"
                android:paddingStart="14dp"
                android:paddingTop="11dp"
                android:paddingEnd="14dp"
                android:paddingBottom="11dp"
                android:textColor="@color/ops_ink"
                android:textSize="15sp"
                tools:text="这是风起时域 AI 的智能回复" />

            <TextView
                android:id="@+id/aiAttachmentText"
                android:layout_width="250dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/pdf_attachment_peer_background"
                android:padding="12dp"
                android:textColor="@color/ops_ink"
                android:textSize="14sp"
                android:visibility="gone"
                tools:text="PDF 附件：工单.pdf"
                tools:visibility="visible" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
