<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F8F5"
    android:padding="24dp"
    tools:context=".LoginActivity">

    <LinearLayout
        android:id="@+id/loginPanel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="风电运维平台"
            android:textColor="#12211A"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="使用 Web 管理端创建的账号登录，同步访问 Windrise 智能助手"
            android:textColor="#66736A"
            android:textSize="15sp" />

        <EditText
            android:id="@+id/usernameInput"
            style="@style/WorkOrderEditText"
            android:layout_marginTop="32dp"
            android:hint="账号"
            android:imeOptions="actionNext"
            android:inputType="text" />

        <EditText
            android:id="@+id/passwordInput"
            style="@style/WorkOrderEditText"
            android:layout_marginTop="12dp"
            android:hint="密码"
            android:imeOptions="actionDone"
            android:inputType="textPassword" />

        <EditText
            android:id="@+id/serverAddressInput"
            style="@style/WorkOrderEditText"
            android:layout_marginTop="12dp"
            android:hint="服务地址，例如 http://10.0.2.2:8766"
            android:imeOptions="actionDone"
            android:inputType="textUri"
            android:singleLine="true" />

        <Button
            android:id="@+id/loginButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="22dp"
            android:background="@drawable/work_order_button_background"
            android:text="登录系统账号"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
