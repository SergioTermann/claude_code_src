<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_background"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:padding="12dp"
    tools:context=".ui.slideshow.SlideshowFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/headerCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardCornerRadius="8dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="8dp"
                android:paddingBottom="10dp">

                <TextView
                    android:id="@+id/companyName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="风电智能运维平台"
                    android:textColor="@color/ops_ink"
                    android:textSize="25sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingExtra="2dp"
                    android:text="面向风场、机型、SCADA/CMS 数据和工单闭环的现场运维工作台"
                    android:textColor="@color/ops_muted"
                    android:textSize="14sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/aboutCard"
            style="@style/OpsInfoCard"
            android:layout_marginTop="14dp">

            <LinearLayout style="@style/OpsInfoCardContent">

                <TextView
                    style="@style/OpsInfoTitle"
                    android:text="平台定位" />

                <TextView
                    android:id="@+id/text_slideshow"
                    style="@style/OpsInfoBody"
                    android:text="围绕风电现场运维，把场站、机型、报警、缺陷、处置步骤和完工回填组织到同一张工单里，减少人工整理成本，提高派工和复盘效率。" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/techCard"
            style="@style/OpsInfoCard">

            <LinearLayout style="@style/OpsInfoCardContent">

                <TextView
                    style="@style/OpsInfoTitle"
                    android:text="核心能力" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/tech1"
                    style="@style/OpsMetricCard">

                    <LinearLayout style="@style/OpsMetricContent">

                        <TextView
                            style="@style/OpsMetricValue"
                            android:text="01" />

                        <LinearLayout style="@style/OpsMetricTextBlock">

                            <TextView
                                style="@style/OpsMetricTitle"
                                android:text="场站与机型联动" />

                            <TextView
                                style="@style/OpsMetricDesc"
                                android:text="根据风场自动筛选对应机型，减少错误选型和人工录入。" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/tech2"
                    style="@style/OpsMetricCard">

                    <LinearLayout style="@style/OpsMetricContent">

                        <TextView
                            style="@style/OpsMetricValue"
                            android:text="02" />

                        <LinearLayout style="@style/OpsMetricTextBlock">

                            <TextView
                                style="@style/OpsMetricTitle"
                                android:text="工单结构化生成" />

                            <TextView
                                style="@style/OpsMetricDesc"
                                android:text="从场景描述中整理故障模式、影响判断、处置步骤和验收标准。" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/tech3"
                    style="@style/OpsMetricCard">

                    <LinearLayout style="@style/OpsMetricContent">

                        <TextView
                            style="@style/OpsMetricValue"
                            android:text="03" />

                        <LinearLayout style="@style/OpsMetricTextBlock">

                            <TextView
                                style="@style/OpsMetricTitle"
                                android:text="报告留存" />

                            <TextView
                                style="@style/OpsMetricDesc"
                                android:text="生成后的工单可导出 PDF，便于派发、归档和现场复盘。" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/advantageCard"
            style="@style/OpsInfoCard">

            <LinearLayout style="@style/OpsInfoCardContent">

                <TextView
                    style="@style/OpsInfoTitle"
                    android:text="运维闭环" />

                <TextView
                    style="@style/OpsInfoBody"
                    android:text="接警研判 -> 模板派工 -> 现场处置 -> 数据复测 -> 完工回填 -> PDF 归档" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/contactCard"
            style="@style/OpsInfoCard"
            android:layout_marginBottom="18dp">

            <LinearLayout style="@style/OpsInfoCardContent">

                <TextView
                    style="@style/OpsInfoTitle"
                    android:text="当前版本" />

                <TextView
                    style="@style/OpsInfoBody"
                    android:text="本地工单模板引擎 · 风场机型下拉台账 · PDF 工单导出 · 面向现场运维的移动端界面" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
