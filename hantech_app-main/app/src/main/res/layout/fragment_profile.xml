<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_background"
    android:fillViewport="true"
    android:padding="12dp"
    tools:context=".ui.profile.ProfileFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="92dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/profileAvatarContainer"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/profile_avatar_background">

                <ImageView
                    android:id="@+id/profileAvatarImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="头像"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/profileAvatarText"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:textColor="#FFFFFF"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    tools:text="张" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/profileNameText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/ops_ink"
                    android:textSize="23sp"
                    android:textStyle="bold"
                    tools:text="张三" />

                <TextView
                    android:id="@+id/accountText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/ops_muted"
                    android:textSize="14sp"
                    tools:text="zhangsan · A 班组" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/profile_panel_background"
            android:elevation="1dp"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="个人设定"
                android:textColor="@color/ops_ink"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/changeAvatarButton"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/input_background"
                android:text="更换头像"
                android:textColor="@color/ops_ink"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/displayNameInput"
                style="@style/WorkOrderEditText"
                android:layout_marginTop="12dp"
                android:hint="姓名" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/roleInput"
                    style="@style/WorkOrderEditText"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:hint="岗位" />

                <EditText
                    android:id="@+id/teamInput"
                    style="@style/WorkOrderEditText"
                    android:layout_width="0dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:hint="班组" />
            </LinearLayout>

            <EditText
                android:id="@+id/stationInput"
                style="@style/WorkOrderEditText"
                android:layout_marginTop="10dp"
                android:hint="常驻场站" />

            <Button
                android:id="@+id/saveProfileButton"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/work_order_button_background"
                android:text="保存设定"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="消息"
            android:textColor="@color/ops_ink"
            android:textSize="18sp"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/coworkerListRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="308dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/profile_panel_background"
            android:clipToPadding="false"
            android:elevation="1dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            tools:listitem="@layout/item_coworker" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
