<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_background"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:padding="12dp"
    tools:context=".ui.settings.SettingsFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="8dp"
            android:paddingBottom="10dp">

            <TextView
                android:id="@+id/text_settings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="系统配置"
                android:textColor="@color/ops_ink"
                android:textSize="25sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="设备台账、工单模板和导出能力已启用"
                android:textColor="@color/ops_muted"
                android:textSize="14sp" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            style="@style/OpsInfoCard">

            <LinearLayout style="@style/OpsInfoCardContent">

                <TextView
                    style="@style/OpsInfoTitle"
                    android:text="账号与服务" />

                <TextView
                    android:id="@+id/accountStatusText"
                    style="@style/OpsInfoBody"
                    android:text="正在读取账号状态" />

                <TextView
                    android:id="@+id/serverAddressText"
                    style="@style/OpsInfoBody"
                    android:layout_marginTop="8dp"
                    android:text="正在读取服务地址" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            style="@style/OpsInfoCard">

            <LinearLayout style="@style/OpsInfoCardContent">

                <TextView
                    style="@style/OpsInfoTitle"
                    android:text="数据字典" />

                <TextView
                    style="@style/OpsInfoBody"
                    android:text="场站/机型映射：已内置&#10;系统部件：变桨、偏航、传动链、发电机、变流器、叶片、通信/SCADA&#10;优先级：P1-P4" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            style="@style/OpsInfoCard">

            <LinearLayout style="@style/OpsInfoCardContent">

                <TextView
                    style="@style/OpsInfoTitle"
                    android:text="工单模板" />

                <TextView
                    style="@style/OpsInfoBody"
                    android:text="故障抢修、巡检消缺、预防检修三类模板已启用，支持安全措施、备件工具和完工回填段落。" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            style="@style/OpsInfoCard"
            android:layout_marginBottom="18dp">

            <LinearLayout style="@style/OpsInfoCardContent">

                <TextView
                    style="@style/OpsInfoTitle"
                    android:text="导出能力" />

                <TextView
                    style="@style/OpsInfoBody"
                    android:text="工单生成后可导出 PDF，通过系统文件选择器保存到本机或云盘目录。" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <Button
            android:id="@+id/logoutButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/work_order_button_background"
            android:text="退出当前账号"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
