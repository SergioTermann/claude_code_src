<?xml version="1.0" encoding="utf-8"?>
<!-- 发光圆形装饰 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 外层光晕 -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#404CAF50" />
            <size
                android:width="120dp"
                android:height="120dp" />
        </shape>
    </item>
    <!-- 中层光晕 -->
    <item
        android:left="10dp"
        android:right="10dp"
        android:top="10dp"
        android:bottom="10dp">
        <shape android:shape="oval">
            <solid android:color="#604CAF50" />
        </shape>
    </item>
    <!-- 内层实心 -->
    <item
        android:left="20dp"
        android:right="20dp"
        android:top="20dp"
        android:bottom="20dp">
        <shape android:shape="oval">
            <solid android:color="#4CAF50" />
        </shape>
    </item>
</layer-list>

